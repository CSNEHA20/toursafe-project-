{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DEV_BYPASS": "true",
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_BYPASS": "false",
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_API_URL": "https://staging-api.toursafe.internal",
        "EXPO_PUBLIC_WS_URL": "wss://staging-api.toursafe.internal/ws"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEV_BYPASS": "false",
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_API_URL": "https://api.toursafe.internal",
        "EXPO_PUBLIC_WS_URL": "wss://api.toursafe.internal/ws"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "ops@toursafe.internal",
        "ascApiKeyId": "ASC_KEY_ID",
        "ascApiKeyIssuerId": "ASC_ISSUER_ID"
      }
    }
  }
}
