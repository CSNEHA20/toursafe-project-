# TourSafe Mobile / Web Client Production Environment Template
EXPO_PUBLIC_API_URL=https://api.toursafe.internal
EXPO_PUBLIC_WS_URL=wss://api.toursafe.internal/ws

# Production feature flags (Strictly disable mock and dev bypass)
EXPO_PUBLIC_DEV_BYPASS=false
EXPO_PUBLIC_USE_MOCK=false

# Supabase Auth Configuration (Client Public Anon Key Only)
EXPO_PUBLIC_SUPABASE_URL=https://auth.toursafe.internal
EXPO_PUBLIC_SUPABASE_ANON_KEY=__SUPABASE_CLIENT_ANON_KEY__

# Map & Tile Provider
EXPO_PUBLIC_MAP_PROVIDER=osm
