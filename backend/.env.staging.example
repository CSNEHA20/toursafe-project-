# TourSafe Staging Environment Configuration Template
ENVIRONMENT=staging
APP_VERSION=1.0.0-rc1
BUILD_SHA=__GIT_COMMIT_SHA__
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

MONGODB_URI=mongodb://toursafe_app:__STAGING_DB_PASSWORD__@staging-mongo.toursafe.internal:27017/toursafe
MONGODB_DATABASE=toursafe
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000
MONGODB_TLS=false

REDIS_URL=redis://:__STAGING_REDIS_PASSWORD__@staging-redis.toursafe.internal:6379/0
REDIS_MAX_CONNECTIONS=20

JWT_SECRET=__STAGING_HIGH_ENTROPY_JWT_SECRET_32CHARS_MIN__
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=toursafe-auth-service
JWT_AUDIENCE=toursafe-client-applications

CORS_ORIGINS=https://staging-app.toursafe.internal,https://staging-admin.toursafe.internal
WS_PING_INTERVAL_SECONDS=30
WS_MAX_PAYLOAD_BYTES=65536

TELEMETRY_RETENTION_DAYS=7
ML_MODEL_VERSION=v1.0.0-rc1

STORAGE_PROVIDER=local
STORAGE_BUCKET_KYC=toursafe-kyc-staging
STORAGE_BUCKET_BACKUPS=toursafe-backups-staging
