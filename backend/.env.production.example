# TourSafe Production Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# Store production secrets in AWS Secrets Manager / HashiCorp Vault / Kubernetes Secrets

ENVIRONMENT=production
APP_VERSION=1.0.0
BUILD_SHA=__GIT_COMMIT_SHA__
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Production Database (MongoDB Replica Set with TLS & Auth)
MONGODB_URI=mongodb://toursafe_app:__STRONG_PROD_DB_PASSWORD__@mongo-node-1.toursafe.internal:27017,mongo-node-2.toursafe.internal:27017,mongo-node-3.toursafe.internal:27017/toursafe?replicaSet=rs0&authSource=toursafe&tls=true&tlsCAFile=/etc/ssl/certs/mongo-ca.pem
MONGODB_DATABASE=toursafe
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000
MONGODB_TLS=true

# Production Redis Cluster / Sentinel with Password & TLS
REDIS_URL=rediss://:__STRONG_REDIS_AUTH_PASS__@redis.toursafe.internal:6379/0
REDIS_MAX_CONNECTIONS=50

# Cryptographic & Authentication Security
JWT_SECRET=__REPLACE_WITH_MINIMUM_32_CHARACTERS_HIGH_ENTROPY_RANDOM_KEY__
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=toursafe-auth-service
JWT_AUDIENCE=toursafe-client-applications

# CORS Restrictions (Strict Explicit Origins, No Wildcard)
CORS_ORIGINS=https://app.toursafe.internal,https://admin.toursafe.internal,https://responders.toursafe.internal
WS_PING_INTERVAL_SECONDS=30
WS_MAX_PAYLOAD_BYTES=65536
MAX_REQUEST_BODY_BYTES=52428800

# Telemetry & ML Settings
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_NOMINAL_FREQUENCY_HZ=50.0
TELEMETRY_MIN_COMPLETENESS_RATIO=0.6
ML_MODEL_VERSION=v1.0.0

# AI Copilot Provider (Keys managed via KMS/Vault)
COPILOT_LLM_PROVIDER=gemini
COPILOT_MODEL=gemini-2.0-flash
COPILOT_TEMPERATURE=0.1
GEMINI_API_KEY=__SECURE_VAULT_INJECTED_GEMINI_KEY__

# Storage & Backup Encryption
STORAGE_PROVIDER=s3
STORAGE_BUCKET_KYC=toursafe-kyc-vault-production
STORAGE_BUCKET_BACKUPS=toursafe-backups-production
STORAGE_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/__KMS_KEY_UUID__
